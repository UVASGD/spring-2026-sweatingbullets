<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="DeathContainer" style="flex-grow: 1; position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.33); display: none;">
        <ui:Label text="Try not to die will ya?" name="DeathText" style="background-color: rgb(96, 63, 39); -unity-background-image-tint-color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); -unity-font-style: bold; color: rgb(53, 0, 0); font-size: 20px; -unity-text-align: middle-center; height: 58px; white-space: nowrap; text-overflow: ellipsis; -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0); letter-spacing: 0; justify-content: flex-start; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-left-radius: 90px; border-bottom-right-radius: 90px; border-top-color: rgb(130, 85, 66); border-top-width: 2px; border-bottom-width: 5px; border-right-width: 3px; border-left-width: 0; border-left-color: rgb(92, 25, 0); border-bottom-color: rgb(92, 25, 0); border-right-color: rgb(92, 25, 0); -unity-text-outline-color: rgb(67, 31, 31); top: 10%; bottom: auto; width: 50%; align-self: center;"/>
        <ui:Button text="Restart" name="RestartButton" style="width: 200px; height: 50px; align-items: stretch; align-self: center; top: 15%;"/>
        <ui:Button text="Quit" name="QuitButton" style="width: 200px; height: 50px; align-self: center; top: 20%;"/>
    </ui:VisualElement>
</ui:UXML>
