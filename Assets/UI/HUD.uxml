<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="HUDRoot" picking-mode="Ignore" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; align-items: center; justify-content: flex-end;">
        <ui:Label text="Find a gun and bullets to defend yourself" name="InitialGuideLabel" picking-mode="Ignore" style="position: absolute; top: 12%; align-self: center; padding-top: 10px; padding-right: 22px; padding-bottom: 12px; padding-left: 22px; background-color: rgb(96, 63, 39); color: rgb(53, 0, 0); -unity-font-style: bold; font-size: 22px; -unity-text-align: middle-center; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-left-radius: 25px; border-bottom-right-radius: 25px; border-top-width: 2px; border-left-width: 2px; border-bottom-width: 5px; border-right-width: 4px; border-top-color: rgb(130, 85, 66); border-left-color: rgb(130, 85, 66); border-bottom-color: rgb(92, 25, 0); border-right-color: rgb(92, 25, 0); display: none;"/>
        <ui:Label text="Press [R] to cock the hammer" name="HammerPromptLabel" picking-mode="Ignore" style="position: absolute; bottom: 22%; align-self: center; padding-top: 8px; padding-right: 18px; padding-bottom: 10px; padding-left: 18px; background-color: rgb(96, 63, 39); color: rgb(53, 0, 0); -unity-font-style: bold; font-size: 18px; -unity-text-align: middle-center; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 18px; border-bottom-right-radius: 18px; border-top-width: 2px; border-left-width: 2px; border-bottom-width: 4px; border-right-width: 3px; border-top-color: rgb(130, 85, 66); border-left-color: rgb(130, 85, 66); border-bottom-color: rgb(92, 25, 0); border-right-color: rgb(92, 25, 0); display: none;"/>
        <ui:Label text="Press [E] to pick up" name="PickupPromptLabel" picking-mode="Ignore" style="position: absolute; bottom: 14%; align-self: center; padding-top: 8px; padding-right: 18px; padding-bottom: 10px; padding-left: 18px; background-color: rgb(96, 63, 39); color: rgb(53, 0, 0); -unity-font-style: bold; font-size: 18px; -unity-text-align: middle-center; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 18px; border-bottom-right-radius: 18px; border-top-width: 2px; border-left-width: 2px; border-bottom-width: 4px; border-right-width: 3px; border-top-color: rgb(130, 85, 66); border-left-color: rgb(130, 85, 66); border-bottom-color: rgb(92, 25, 0); border-right-color: rgb(92, 25, 0); display: none;"/>
