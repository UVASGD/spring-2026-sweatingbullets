.overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}

.overlay.visible {
    opacity: 1;
}

.win-container {
    align-items: center;
    justify-content: center;
    padding: 60px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 8px;
}

.win-title {
    font-size: 72px;
    color: rgb(255, 220, 80);
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-bottom: 8px;
}

.win-subtitle {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 3px;
    margin-bottom: 48px;
}

.win-button {
    width: 220px;
    height: 50px;
    margin-bottom: 16px;
    background-color: rgb(255, 220, 80);
    border-width: 0;
    border-radius: 4px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(20, 20, 20);
    letter-spacing: 2px;
    cursor: link;
}

.win-button.secondary {
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.4);
    color: rgba(255, 255, 255, 0.7);
}