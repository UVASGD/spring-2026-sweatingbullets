<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="flex-grow: 1; position: absolute; top: 0; bottom: 0; left: 0; right: 0; visibility: visible; background-color: rgba(55, 55, 55, 0); opacity: 1; display: none; justify-content: center; align-self: center; align-content: center; align-items: center;">
        <ui:VisualElement name="DimBackground" enabled="true" style="flex-grow: 1; position: absolute; background-color: rgb(0, 0, 0); opacity: 0.5; display: flex; top: 0; left: 0; bottom: 0; right: 0;"/>
        <ui:VisualElement name="Panel" style="flex-grow: 1; width: 360px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; background-color: rgb(96, 63, 39); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; align-self: auto; align-items: center; height: 80%; background-size: 100% 100%; border-top-width: 4px; border-left-width: 4px; border-bottom-width: 10px; border-right-width: 8px; border-bottom-color: rgb(72, 25, 0); border-right-color: rgb(72, 25, 0); border-left-color: rgb(130, 85, 66); border-top-color: rgb(130, 86, 66); margin-top: 10px; margin-bottom: 30px; position: relative; opacity: 1; display: flex;">
            <ui:Label text="Paused " name="Paused" style="font-size: 50px; -unity-font-style: bold; color: rgb(10, 4, 4); -unity-font-definition: url(&quot;project://database/Assets/PauseMenuUI/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=d0aa2021ea0dc4ff1af38c0312ef40c7&amp;type=3#NotInter-Regular&quot;); border-bottom-width: 4px; border-bottom-color: rgb(63, 10, 10); width: 100%; -unity-text-align: upper-center;"/>
            <ui:Label text="Ya still nervous even with a breather!  " name="Text" style="font-size: 16px; -unity-font-style: bold; color: rgb(53, 0, 0); -unity-font-definition: url(&quot;project://database/Assets/PauseMenuUI/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=d0aa2021ea0dc4ff1af38c0312ef40c7&amp;type=3#NotInter-Regular&quot;); height: 10%; -unity-text-align: upper-center; width: 100%;"/>
            <ui:Button text="Continue Sweating " name="ResumeButton" style="width: 100%; height: 80px; align-items: center; background-color: rgb(96, 63, 39); padding-bottom: 10px; font-size: 25px; color: rgb(0, 0, 0); -unity-font-style: bold; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; border-bottom-width: 8px; border-right-width: 8px; border-top-width: 4px; border-left-width: 4px; border-right-color: rgb(72, 25, 0); border-bottom-color: rgb(72, 25, 0); border-left-color: rgb(130, 85, 66); border-top-color: rgb(130, 85, 66); margin-bottom: 20px;"/>
            <ui:Button text="Bite the Bullet " name="RestartButton" style="width: 100%; height: 80px; align-items: center; background-color: rgb(96, 63, 39); font-size: 25px; color: rgb(0, 0, 0); -unity-font-style: bold; border-bottom-width: 8px; border-bottom-color: rgb(72, 25, 0); border-right-color: rgb(72, 25, 0); border-right-width: 8px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-top-left-radius: 20px; border-bottom-left-radius: 20px; border-left-width: 4px; border-top-width: 4px; border-left-color: rgb(130, 85, 66); border-top-color: rgb(130, 85, 66); margin-bottom: 20px;"/>
            <ui:Button text="Quit Like a Wimp " name="QuitButton" style="width: 100%; height: 80px; align-items: center; background-color: rgb(96, 63, 39); font-size: 25px; -unity-font-style: bold; color: rgb(0, 0, 0); border-left-width: 4px; border-top-width: 4px; border-bottom-width: 8px; border-right-width: 8px; border-bottom-left-radius: 20px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-color: rgb(72, 25, 0); border-right-color: rgb(72, 25, 0); border-left-color: rgb(130, 85, 66); border-top-color: rgb(130, 85, 66); margin-bottom: 50px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
